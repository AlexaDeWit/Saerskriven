{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist",
    "tsBuildInfoFile": "dist/tsconfig.lib.tsbuildinfo",
    "emitDeclarationOnly": true,
    // The driver instantiates WebAssembly modules, and only lib.dom and
    // lib.webworker declare that namespace: with es2022 alone this program
    // stops with seven errors, TS2503 and TS2304 on src/lib/boundary.ts.
    // webworker is the narrower of the two and declares neither document nor
    // window.
    "lib": ["webworker", "es2022"],
    "forceConsistentCasingInFileNames": true,
    "types": ["node"]
  },
  "include": ["src/**/*.ts"],
  "references": [],
  "exclude": [
    "vite.config.ts",
    "vite.config.mts",
    "vitest.config.ts",
    "vitest.config.mts",
    "src/fixtures.ts",
    "src/**/*.fixtures.ts",
    "src/**/*.test.ts",
    "src/**/*.spec.ts"
  ]
}
