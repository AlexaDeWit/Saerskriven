{
  "name": "@saerskriven/formats",
  "version": "0.8.2",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./brotli": {
      "types": "./src/brotli.ts",
      "import": "./src/brotli.ts",
      "default": "./src/brotli.ts"
    },
    "./build-assets": {
      "types": "./src/build-assets.ts",
      "import": "./src/build-assets.ts",
      "default": "./src/build-assets.ts"
    },
    "./fixtures": {
      "types": "./src/fixtures.ts",
      "import": "./src/fixtures.ts",
      "default": "./src/fixtures.ts"
    },
    "./hosted-studio": {
      "types": "./src/hosted-studio.ts",
      "import": "./src/hosted-studio.ts",
      "default": "./src/hosted-studio.ts"
    },
    "./share-link": {
      "types": "./src/share-link.ts",
      "import": "./src/share-link.ts",
      "default": "./src/share-link.ts"
    },
    "./package.json": "./package.json"
  },
  "dependencies": {
    "@saerskriven/model": "workspace:*",
    "@saerskriven/wasm": "workspace:*",
    "@saerskriven/wire-saerskriven-yaml": "workspace:*",
    "@saerskriven/wire-saerskriven-yaml-v2": "workspace:*",
    "@saerskriven/wire-threat-dragon": "workspace:*",
    "effect": "catalog:",
    "yaml": "catalog:",
    "zod": "catalog:",
    "@saerskriven/wire-otm": "workspace:*",
    "@saerskriven/wire-tmbom": "workspace:*"
  },
  "devDependencies": {
    "ajv": "catalog:",
    "fast-check": "catalog:"
  },
  "nx": {
    "tags": [
      "layer:formats"
    ],
    "targets": {
      "boundaries": {},
      "lint": {},
      "test": {
        "dependsOn": [
          "...",
          {
            "projects": [
              "brotli-wasm"
            ],
            "target": "build"
          }
        ],
        "inputs": [
          "...",
          "testFixtures",
          "{workspaceRoot}/docs/saerskriven-yaml.md",
          {
            "dependentTasksOutputFiles": "dist/brotli-wasm/lib/**/*",
            "transitive": false
          },
          {
            "env": "SAERSKRIVEN_BROTLI_WASM"
          }
        ]
      }
    }
  }
}
