{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "./out-tsc/vitest",
    // The resize controls spec mounts React Flow under jsdom and presses a
    // control, so it reads the document and builds mouse events, which only
    // lib.dom declares.
    "lib": ["dom", "es2022"],
    "types": [
      "vitest/globals",
      "vitest/importMeta",
      "vite/client",
      "node",
      "vitest"
    ],
    "module": "esnext",
    "moduleResolution": "bundler"
  },
  "include": [
    "src/fixtures.ts",
    "src/**/*.fixtures.ts",
    "src/**/*.fixtures.tsx",
    "src/**/*.test.ts",
    "src/**/*.spec.ts",
    "src/**/*.test.tsx",
    "src/**/*.spec.tsx",
    "src/**/*.test.js",
    "src/**/*.spec.js",
    "src/**/*.test.jsx",
    "src/**/*.spec.jsx",
    "src/**/*.d.ts"
  ],
  "references": [
    {
      "path": "./tsconfig.lib.json"
    }
  ]
}
