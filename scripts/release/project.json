{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "release-tools",
  "projectType": "application",
  "sourceRoot": "scripts/release",
  "targets": {
    "lint": {
      "inputs": ["...", "toolsFixtures"],
      "options": {
        "command": "oxlint scripts/release scripts/tools.fixtures.mts"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": [
        "default",
        "sharedGlobals",
        "toolsFixtures",
        "{workspaceRoot}/.github/workflows/ci.yml",
        "{workspaceRoot}/flake.lock",
        "{workspaceRoot}/nix/release.json",
        {
          "externalDependencies": ["effect", "zod", "yaml"]
        }
      ],
      "options": {
        "commands": [
          {
            "command": "node --test scripts/release/*.test.mts",
            "forwardAllArgs": false
          }
        ]
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": [
        "default",
        "toolsFixtures",
        "{workspaceRoot}/tsconfig.base.json",
        {
          "externalDependencies": ["effect", "typescript", "zod", "yaml"]
        }
      ],
      "options": {
        "command": "tsc --noEmit --project scripts/release/tsconfig.json"
      }
    },
    "prepare": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "commands": [
          {
            "command": "scripts/release/release.mts prepare",
            "forwardAllArgs": false
          }
        ]
      }
    },
    "tag": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "commands": [
          {
            "command": "scripts/release/release.mts tag",
            "forwardAllArgs": false
          }
        ]
      }
    },
    "update-nix": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "commands": [
          {
            "command": "scripts/release/nix-release.mts",
            "forwardAllArgs": false
          }
        ]
      }
    }
  }
}
